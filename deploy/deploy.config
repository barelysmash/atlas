# Atlas deployment configuration.
# Sourced by all deploy scripts.

# Hosts
BASTION_HOST="${BASTION_HOST:-barelysmash@barelysmash}"
TARGET_HOST="${TARGET_HOST:-guildenstern}"
TARGET_USER="${TARGET_USER:-ocelia}"

# Local source root: one level above deploy/.
LOCAL_SOURCE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Bastion staging.
BASTION_STAGING="${BASTION_STAGING:-/tmp/atlas-deploy-staging}"

# Target paths.
TARGET_HOME="/home/${TARGET_USER}"
TARGET_INSTALL="${TARGET_HOME}/atlas"
TARGET_PREVIOUS="${TARGET_HOME}/atlas-previous"
TARGET_DATA="${TARGET_HOME}/atlas-data"
TARGET_RELEASES="${TARGET_HOME}/atlas-releases"

# Runtime.
PYTHON_VERSION="${PYTHON_VERSION:-python3.12}"
WORKLOAD_MANIFEST_RELATIVE="deploy/workloads.toml"
KEEP_RELEASES="${KEEP_RELEASES:-5}"

# Build artifact.
RELEASE_NAME="atlas-$(date +%Y%m%d-%H%M%S)"
RELEASE_TARBALL="/tmp/${RELEASE_NAME}.tar.gz"
