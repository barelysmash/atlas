[Unit]
Description=Atlas RestaurantOS Gmail nightly refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/atlas
ExecStart=%h/atlas/.venv/bin/python %h/atlas/deploy/bin/restaurantos_nightly.py
Environment=PYTHONUNBUFFERED=1
Environment=ATLAS_DATA_ROOT=%h/atlas-data
Environment=ATLAS_TIMEZONE=America/Chicago
UMask=0077
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/atlas-data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
